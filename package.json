{
  "name": "dsh-model-show",
  "version": "1.0.0",
  "description": "Composer model selector shows Provider/Model — 对话框模型选择器显示「供应商/模型」",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "ken95573",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ken95573/dsh-model-show.git"
  },
  "homepage": "https://github.com/ken95573/dsh-model-show#readme",
  "bugs": {
    "url": "https://github.com/ken95573/dsh-model-show/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "model-selector",
    "provider"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test",
    "vendor": "node scripts/vendor-from-asar.mjs",
    "vendor:check": "node scripts/vendor-from-asar.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-store"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
